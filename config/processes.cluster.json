{
  "_说明": [
    "纯 Python 多节点集群档：并行拉起全部 24 个微服务与核心节点，端口与 config/cluster.example.toml 及 config/portal.example.toml 对齐且互不冲突。",
    "requires 仅做启动前外部基础设施（MySQL/Redis/etcd/Kafka）TCP 连通性体检，不负责拉起基础设施进程。",
    "同机联调时请确保 portal.example.toml 的 management_port 与 gm_admin_node.port 不冲突（示例仅探测 portal 主端口 8080）。"
  ],
  "profile": "cluster",
  "storage": "mysql",
  "requires": [
    {
      "name": "mysql",
      "host": "127.0.0.1",
      "port": 3306
    },
    {
      "name": "redis",
      "host": "127.0.0.1",
      "port": 6379
    },
    {
      "name": "etcd",
      "host": "127.0.0.1",
      "port": 2379
    },
    {
      "name": "kafka",
      "host": "127.0.0.1",
      "port": 9092
    }
  ],
  "processes": [
    {
      "name": "data-service",
      "command": [
        "-m",
        "xuanming",
        "data-service",
        "--config",
        "config/cluster.example.toml"
      ],
      "host": "127.0.0.1",
      "port": 9000
    },
    {
      "name": "db",
      "command": [
        "-m",
        "xuanming",
        "db",
        "--config",
        "config/cluster.example.toml"
      ],
      "host": "127.0.0.1",
      "port": 6000
    },
    {
